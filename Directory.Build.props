<Project>
  <PropertyGroup>
    <!--
      Canonical app version. Bump this when cutting a release.
      It is stamped into the assembly at build time (shown in the context menu)
      and passed to installer.iss by build-pipeline.ps1.
    -->
    <Version>0.9.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
